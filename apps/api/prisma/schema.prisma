generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
    system
    user
    assistant
    tool
}

enum ConversationChunkStatus {
    open
    closed
}

enum ObservabilityTraceKind {
    llm
    tool
}

enum ObservabilityTraceStatus {
    success
    error
    timeout
}

enum TemporalRelationType {
    SUPERSEDES
    CORRECTS
}

model ApplicationSettings {
  id                              Int      @id @default(1)
  llmCombo                        String   @default("local-general") @map("llm_combo")
  orchestratorCombo               String   @default("local-general") @map("orchestrator_combo")
  appTimezone                     String   @default("America/Sao_Paulo") @map("app_timezone")
  llmTemperature                  Float?   @map("llm_temperature")
  llmMaxTokens                    Int?     @map("llm_max_tokens")
  immediateContextMaxTokens       Int      @default(32000) @map("immediate_context_max_tokens")
  orchestratorMaxIterations       Int      @default(4) @map("orchestrator_max_iterations")
  orchestratorMaxToolCalls        Int      @default(3) @map("orchestrator_max_tool_calls")
  orchestratorToolResultMaxTokens Int      @default(1000) @map("orchestrator_tool_result_max_tokens")
  retrievalDefaultTopK            Int      @default(8) @map("retrieval_default_top_k")
  retrievalMaxTopK                Int      @default(50) @map("retrieval_max_top_k")
  retrievalDefaultMaxContextTokens Int     @default(8000) @map("retrieval_default_max_context_tokens")
  retrievalMaxContextTokens       Int      @default(20000) @map("retrieval_max_context_tokens")
  retrievalIncludeMessages        Boolean  @default(true) @map("retrieval_include_messages")
  retrievalStrategy               String   @default("hybrid") @map("retrieval_strategy")
  retrievalVectorTopK             Int      @default(30) @map("retrieval_vector_top_k")
  retrievalLexicalTopK            Int      @default(30) @map("retrieval_lexical_top_k")
  retrievalRrfK                   Int      @default(60) @map("retrieval_rrf_k")
  retrievalCandidatePoolTopK      Int      @default(30) @map("retrieval_candidate_pool_top_k")
  retrievalRerankerEnabled        Boolean  @default(false) @map("retrieval_reranker_enabled")
  retrievalRerankerModel          String   @default("cross-encoder/ettin-reranker-17m-v1") @map("retrieval_reranker_model")
  retrievalRerankerTopK           Int      @default(30) @map("retrieval_reranker_top_k")
  retrievalRerankerThreshold      Float    @default(8.0) @map("retrieval_reranker_threshold")
  retrievalDeduplicationEnabled   Boolean  @default(true) @map("retrieval_deduplication_enabled")
  retrievalDeduplicationThreshold Float    @default(0.85) @map("retrieval_deduplication_threshold")
  conversationEvidenceEnabled     Boolean  @default(false) @map("conversation_evidence_enabled")
  temporalConsolidationEnabled       Boolean @default(false) @map("temporal_consolidation_enabled")
  temporalConsolidationDefaultCombo  String? @default("local-general") @map("temporal_consolidation_default_combo")
  temporalConsolidationFallbackCombo String? @default("paid-general") @map("temporal_consolidation_fallback_combo")
  temporalConsolidationStartTime     String  @default("04:30") @map("temporal_consolidation_start_time")
  temporalConsolidationEndTime       String  @default("08:30") @map("temporal_consolidation_end_time")
  researchEnabled                    Boolean @default(true) @map("research_enabled")
  researchSearchOrchestratorCombo    String  @default("local-reasoning") @map("research_search_orchestrator_combo")
  researchDefaultMode                String  @default("quick") @map("research_default_mode")
  researchDefaultRecency             String  @default("auto") @map("research_default_recency")
  researchMaxSources                 Int     @default(5) @map("research_max_sources")
  researchMaxRounds                  Int     @default(2) @map("research_max_rounds")
  researchMaxQueries                 Int     @default(3) @map("research_max_queries")
  researchSearchProvider             String  @default("searxng") @map("research_search_provider")
  researchExtractionProvider         String  @default("static-with-browser-fallback") @map("research_extraction_provider")
  researchCacheEnabled               Boolean @default(true) @map("research_cache_enabled")
  researchBrowserFallbackEnabled     Boolean @default(true) @map("research_browser_fallback_enabled")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@map("application_settings")
}

model Conversation {
  id               String                       @id @default(uuid()) @db.Uuid
  title            String?
  summary          String?                      @db.Text
  summaryEmbedding Unsupported("vector(1024)")? @map("summary_embedding")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")
  messages         Message[]
  chunks           ConversationChunk[]
  observabilityTraces ObservabilityTrace[]
  researchRuns     ResearchRun[]

  @@map("conversations")
}

model Message {
  id                 String              @id @default(uuid()) @db.Uuid
  conversationId     String              @map("conversation_id") @db.Uuid
  role               MessageRole
  content            String              @db.Text
  model              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chunksStartingHere ConversationChunk[] @relation("ChunkStartMessage")
  chunksEndingHere   ConversationChunk[] @relation("ChunkEndMessage")
  observabilityTraces ObservabilityTrace[] @relation("MessageResponseTrace")
  evidences          ConversationEvidence[]
  temporalPredecessorRelation TemporalRelation? @relation("TemporalPredecessor")
  temporalSuccessorRelations  TemporalRelation[] @relation("TemporalSuccessor")
  researchRuns      ResearchRun[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ConversationEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  sequence    Int      @unique @default(autoincrement())
  messageId   String   @map("message_id") @db.Uuid
  sourceType  String   @default("conversation_retrieval") @map("source_type")
  dateFrom    DateTime @map("date_from") @db.Timestamptz(3)
  dateTo      DateTime @map("date_to") @db.Timestamptz(3)
  dates       String[]
  timeZone    String   @map("time_zone")
  sourceReferences Json   @map("source_references")
  createdAt   DateTime @default(now()) @map("created_at")
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("conversation_evidences")
}

model ConversationChunk {
  id                   String                       @id @default(uuid()) @db.Uuid
  conversationId       String                       @map("conversation_id") @db.Uuid
  content              String                       @db.Text
  embedding            Unsupported("vector(1024)")?
  startMessageId       String                       @map("start_message_id") @db.Uuid
  endMessageId         String                       @map("end_message_id") @db.Uuid
  status               ConversationChunkStatus     @default(open)
  tokenCount           Int                          @default(0) @map("token_count")
  createdAt            DateTime                     @default(now()) @map("created_at")
  conversation         Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startMessage         Message                      @relation("ChunkStartMessage", fields: [startMessageId], references: [id], onDelete: Cascade)
  endMessage           Message                      @relation("ChunkEndMessage", fields: [endMessageId], references: [id], onDelete: Cascade)

  @@index([conversationId, status, createdAt])
  @@index([startMessageId])
  @@index([endMessageId])
  @@map("conversation_chunks")
}

model ConversationChunkSettings {
  id                       Int      @id @default(1)
  maxTokens                Int      @default(4000) @map("max_tokens")
  overlapTokens            Int      @default(800) @map("overlap_tokens")
  embeddingRefreshTokens   Int      @default(1000) @map("embedding_refresh_tokens")
  embeddingModel           String   @default("qwen3-embedding:0.6b") @map("embedding_model")
  embeddingDimensions      Int      @default(1024) @map("embedding_dimensions")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("conversation_chunk_settings")
}

model ObservabilityTrace {
  id                    String                    @id @default(uuid()) @db.Uuid
  requestId             String?                   @map("request_id")
  conversationId        String?                   @map("conversation_id") @db.Uuid
  responseMessageId     String?                   @unique @map("response_message_id") @db.Uuid
  kind                  ObservabilityTraceKind
  status                ObservabilityTraceStatus
  toolName              String?                   @map("tool_name")
  combo                 String?
  model                 String?
  inputTokens           Int                       @default(0) @map("input_tokens")
  outputTokens          Int                       @default(0) @map("output_tokens")
  totalTokens           Int                       @default(0) @map("total_tokens")
  estimatedInputTokens  Int                       @default(0) @map("estimated_input_tokens")
  estimatedOutputTokens Int                       @default(0) @map("estimated_output_tokens")
  latencyMs             Int                       @default(0) @map("latency_ms")
  stageDurations        Json?                     @map("stage_durations")
  contextSnapshot       Json?                     @map("context_snapshot")
  errorMessage          String?                   @map("error_message") @db.Text
  startedAt             DateTime                  @map("started_at")
  completedAt           DateTime?                 @map("completed_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  conversation          Conversation?            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  responseMessage       Message?                  @relation("MessageResponseTrace", fields: [responseMessageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([conversationId, createdAt])
  @@index([kind, status, createdAt])
  @@map("observability_traces")
}

model TemporalRelation {
  id                   String               @id @default(uuid()) @db.Uuid
  predecessorMessageId String               @unique @map("predecessor_message_id") @db.Uuid
  successorMessageId   String               @map("successor_message_id") @db.Uuid
  type                 TemporalRelationType
  subject              String               @db.Text
  oldValue             String               @map("old_value") @db.Text
  newValue             String               @map("new_value") @db.Text
  confidence           Float
  reason               String               @db.Text
  createdAt            DateTime             @default(now()) @map("created_at")
  predecessorMessage   Message              @relation("TemporalPredecessor", fields: [predecessorMessageId], references: [id], onDelete: Cascade)
  successorMessage     Message              @relation("TemporalSuccessor", fields: [successorMessageId], references: [id], onDelete: Cascade)

  @@index([successorMessageId])
  @@index([createdAt])
  @@map("temporal_relations")
}

model TemporalConsolidationCheckpoint {
  id                   Int      @id @default(1)
  lastMessageCreatedAt DateTime? @map("last_message_created_at")
  lastMessageId        String?  @map("last_message_id") @db.Uuid
  activeRunId          String?  @map("active_run_id") @db.Uuid
  lockExpiresAt        DateTime? @map("lock_expires_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("temporal_consolidation_checkpoint")
}

model TemporalConsolidationRun {
  id                            String   @id @default(uuid()) @db.Uuid
  trigger                       String
  status                        String
  currentPhase                  String?  @map("current_phase")
  currentPhaseStartedAt         DateTime? @map("current_phase_started_at")
  progressUpdatedAt             DateTime? @map("progress_updated_at")
  phaseDurationsMs              Json     @default("{}") @map("phase_durations_ms")
  dryRun                        Boolean  @default(false) @map("dry_run")
  startedAt                     DateTime @default(now()) @map("started_at")
  finishedAt                    DateTime? @map("finished_at")
  defaultCombo                  String?  @map("default_combo")
  fallbackCombo                 String?  @map("fallback_combo")
  actualCombo                   String?  @map("actual_combo")
  provider                      String?
  model                         String?
  messagesScanned               Int      @default(0) @map("messages_scanned")
  chunksScanned                 Int      @default(0) @map("chunks_scanned")
  candidatesDetected            Int      @default(0) @map("candidates_detected")
  llmCalls                      Int      @default(0) @map("llm_calls")
  historicalRetrievalCalls      Int      @default(0) @map("historical_retrieval_calls")
  relationsProposed             Int      @default(0) @map("relations_proposed")
  relationsCreated              Int      @default(0) @map("relations_created")
  relationsRejected             Int      @default(0) @map("relations_rejected")
  relationsSkipped              Int      @default(0) @map("relations_skipped")
  fallbackUsed                  Boolean  @default(false) @map("fallback_used")
  fallbackReason                String?  @map("fallback_reason")
  retryCount                    Int      @default(0) @map("retry_count")
  errorCount                    Int      @default(0) @map("error_count")
  candidateDetectionLatencyMs   Int      @default(0) @map("candidate_detection_latency_ms")
  llmLatencyMs                  Int      @default(0) @map("llm_latency_ms")
  historicalRetrievalLatencyMs  Int      @default(0) @map("historical_retrieval_latency_ms")
  validationLatencyMs           Int      @default(0) @map("validation_latency_ms")
  persistenceLatencyMs          Int      @default(0) @map("persistence_latency_ms")
  rejectionReasons              Json?    @map("rejection_reasons")
  proposed                      Json?
  rejected                      Json?
  hasMore                       Boolean  @default(false) @map("has_more")
  errorMessage                  String?  @map("error_message") @db.Text

  @@index([startedAt])
  @@index([status, startedAt])
  @@map("temporal_consolidation_runs")
}

model ResearchRun {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  requestId      String?  @map("request_id")
  question       String   @db.Text
  status         String
  mode           String
  plannerCombo   String   @map("planner_combo")
  summaryContext String?  @map("summary_context") @db.Text
  metadata       Json?
  startedAt      DateTime @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  events         ResearchEvent[]
  sources        ResearchSource[]
  evidence       ResearchEvidence[]

  @@index([conversationId, startedAt])
  @@index([messageId])
  @@map("research_runs")
}

model ResearchEvent {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  sequence  Int
  type      String
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@map("research_events")
}

model ResearchSource {
  id               String
  runId            String   @map("run_id") @db.Uuid
  normalizedUrl    String   @map("normalized_url") @db.Text
  url              String   @db.Text
  title            String   @db.Text
  domain           String
  sourceType       String   @map("source_type")
  rank             Int?
  publishedAt      DateTime? @map("published_at")
  retrievedAt      DateTime @map("retrieved_at")
  extractionMethod String?  @map("extraction_method")
  metadata         Json?
  run              ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence         ResearchEvidence[]

  @@id([runId, id])
  @@unique([runId, normalizedUrl])
  @@index([runId])
  @@map("research_sources")
}

model ResearchEvidence {
  id        String   @id
  runId     String   @map("run_id") @db.Uuid
  sourceId  String   @map("source_id")
  text      String   @db.Text
  location  String?  @db.Text
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  run       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  source    ResearchSource @relation(fields: [runId, sourceId], references: [runId, id], onDelete: Cascade)

  @@index([runId])
  @@index([sourceId])
  @@map("research_evidence")
}
