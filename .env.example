# The current V2 database volume is reused by default, so existing conversations
# survive the migration from apps/docker-compose.yml to the root Compose file.
LUNA_V2_POSTGRES_VOLUME=apps_luna_postgres_data
LUNA_V2_OLLAMA_VOLUME=luna_luna-ollama-data
LUNA_V2_POSTGRES_PORT=5432
LUNA_V2_OLLAMA_PORT=11435
LUNA_V2_API_PORT=8000
LUNA_V2_WEB_PORT=3000

# The actual tags used by the previous Luna project's Ollama bootstrap.
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://ollama:11434

LLM_COMBO=paid-general
ORCHESTRATOR_COMBO=local-general
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1

# SearXNG is only exposed to the Compose network.
SEARXNG_SECRET=change-this-for-a-shared-machine
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_TIMEOUT_MS=8000
WEB_EXTRACT_TIMEOUT_MS=12000
WEB_EXTRACT_MAX_BYTES=2000000
